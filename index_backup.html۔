:25px;color:var(--green)}
.section{padding:36px 0 64px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.section-head h2{font-size:clamp(26px,4vw,38px);margin:5px 0}.muted{color:var(--muted)}.searchbar{width:min(340px,100%);padding:12px 15px;border:1px solid var(--line);background:#0c1a30;color:var(--text);border-radius:12px;outline:none}.searchbar:focus,.field:focus,textarea:focus,select:focus{border-color:var(--cyan);box-shadow:0 0 0 3px #31e6f21b;outline:none}.tool-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.tool-card{border:1px solid var(--line);border-radius:18px;padding:19px;background:linear-gradient(145deg,#12233d,#0d1a30);transition:.2s;cursor:pointer;min-height:160px}.tool-card:hover{transform:translateY(-4px);border-color:#4e8ba8;box-shadow:0 14px 35px #0003}.tool-icon{width:43px;height:43px;border-radius:13px;background:#173652;color:var(--cyan);display:grid;place-items:center;font-size:22px;margin-bottom:12px}.tool-card h3{margin:0 0 5px}.tool-card p{color:var(--muted);font-size:13px;margin:0}.tool-view{display:none;border:1px solid var(--line);border-radius:22px;background:#0d1b31;padding:24px;margin-top:24px;box-shadow:var(--shadow)}.tool-view.active{display:block}.tool-title{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:18px}.tool-title h2{margin:0}.tool-title button{background:transparent;border:1px solid var(--line);color:var(--muted);border-radius:10px;padding:7px 11px}.tool-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.panel{background:#12233d;border:1px solid #29415f;border-radius:16px;padding:18px;min-width:0}.panel h3{margin:0 0 12px;font-size:16px}.field{width:100%;padding:11px 12px;border-radius:10px;border:1px solid #345174;background:#09172b;color:var(--text);margin:6px 0 12px}.field[type=file]{padding:9px}.field-label{font-size:13px;color:var(--muted);display:block;margin-top:7px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row>*{flex:1}.result{background:#09172b;border:1px dashed #3b5b7c;border-radius:12px;padding:13px;margin-top:12px;min-height:48px;overflow-wrap:anywhere}.result img{max-width:100%;height:auto;border-radius:9px}.notice{font-size:12px;color:var(--muted);margin-top:12px}.status{color:var(--green);font-size:13px;min-height:20px;margin-top:8px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 18px}.tab{border:1px solid var(--line);background:#0b1a30;color:var(--muted);border-radius:9px;padding:8px 12px}.tab.active{border-color:var(--cyan);color:var(--cyan);background:#12304a}.page{display:none;padding:42px 0 75px;min-height:55vh}.page.active{display:block}.prose{max-width:850px;background:#0e1d33;border:1px solid var(--line);border-radius:18px;padding:26px}.prose h2,.prose h3{color:var(--cyan)}.prose li{margin:7px 0}.footer{border-top:1px solid var(--line);padding:30px 0 40px;background:#061020}.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer-links{display:flex;gap:15px;flex-wrap:wrap}.footer button{background:none;border:0;color:var(--muted);padding:0}.footer button:hover{color:var(--cyan)}.hidden{display:none!important}canvas{max-width:100%}
