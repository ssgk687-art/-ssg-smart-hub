<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
const toolNames=['image','pdf','text','qr','color','creator','web','learning'];
function showPage(name){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));const target=document.getElementById('page-'+name);if(target)target.classList.add('active');document.querySelectorAll('.navlinks [data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===name));document.querySelector('.navlinks').classList.remove('open');window.scrollTo({top:0,behavior:'smooth'});}
function openTool(name){showPage('home');closeTools();const el=document.getElementById('tool-'+name);if(el){el.classList.add('active');el.scrollIntoView({behavior:'smooth',block:'start'});}}
function closeTools(){document.querySelectorAll('.tool-view').forEach(v=>v.classList.remove('active'))}
document.querySelectorAll('#toolGrid .tool-card').forEach((c,i)=>c.addEventListener('click',()=>openTool(toolNames[i])));
const allGrid=document.getElementById('allToolGrid');document.querySelectorAll('#toolGrid .tool-card').forEach((c,i)=>{const clone=c.cloneNode(true);clone.addEventListener('click',()=>openTool(toolNames[i]));allGrid.appendChild(clone)});
function filterTools(q){document.querySelectorAll('#toolGrid .tool-card').forEach(c=>c.classList.toggle('hidden',!c.dataset.search.includes(q.toLowerCase())))}
let imgObj=null,imgMode='resize',processedBlob=null;
document.getElementById('imgFile').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const url=URL.createObjectURL(f);const im=new Image();im.onload=()=>{imgObj=im;imgWidth.value=im.width;imgHeight.value=im.height;imgPreview.innerHTML=`<img src="${url}" alt="Image preview"><div class="notice">${im.width} × ${im.height}px · ${(f.size/1024).toFixed(1)} KB</div>`;imgStatus.textContent='Image loaded successfully.'};im.src=url});
imgWidth?.addEventListener('input',()=>{if(imgObj&&imgLock.checked)imgHeight.value=Math.round(imgWidth.value*imgObj.height/imgObj.width)});
imgHeight?.addEventListener('input',()=>{if(imgObj&&imgLock.checked)imgWidth.value=Math.round(imgHeight.value*imgObj.width/imgObj.height)});
function imageTab(mode,btn){imgMode=mode;document.querySelectorAll('#tool-image .tab').forEach(t=>t.classList.remove('active'));btn.classList.add('active');imageResizeControls.classList.toggle('hidden',mode!=='resize');imageCompressControls.classList.toggle('hidden',mode!=='compress');imageConvertControls.classList.toggle('hidden',mode!=='convert');}
function processImage(){if(!imgObj){imgStatus.textContent='Please choose an image first.';return}let w=imgObj.width,h=imgObj.height,type='image/jpeg',quality=.8;if(imgMode==='resize'){w=Math.max(1,Number(imgWidth.value)||imgObj.width);h=Math.max(1,Number(imgHeight.value)||imgObj.height)}if(imgMode==='compress'){const max=Number(imgMaxWidth.value);if(max>0&&w>max){h=Math.round(h*max/w);w=max}quality=Number(imgQuality.value)/100}if(imgMode==='convert'){type=imgFormat.value;quality=Number(convertQuality.value)/100}const c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(imgObj,0,0,w,h);c.toBlob(blob=>{if(!blob){imgStatus.textContent='This format could not be created by your browser.';return}processedBlob=blob;const url=URL.createObjectURL(blob);imgResult.innerHTML=`<img src="${url}" alt="Processed image"><div class="notice">${w} × ${h}px · ${(blob.size/1024).toFixed(1)} KB</div><button class="btn small" id="downloadImage">Download image</button>`;document.getElementById('downloadImage').onclick=()=>downloadBlob(blob,'ssg-smart-hub-image.'+(type==='image/png'?'png':type==='image/webp'?'webp':'jpg'));imgStatus.textContent='Done — your image is ready to download.'},type,quality)}
function downloadBlob(blob,name){const a=document.createElement('a');const u=URL.createObjectURL(blob);a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1500)}
function updateTextStats(){const t=textInput.value;const words=t.trim()?t.trim().split(/\s+/).length:0;const sentences=(t.match(/[.!?]+/g)||[]).length;textStats.textContent=`Words: ${words} · Characters: ${t.length} · Characters (no spaces): ${t.replace(/\s/g,'').length} · Sentences: ${sentences} · Reading time: ${Math.ceil(words/200)} min`}
function changeCase(m){const el=textInput;const s=el.value;el.value=m==='upper'?s.toUpperCase():m==='lower'?s.toLowerCase():s.toLowerCase().replace(/\b\w/g,c=>c.toUpperCase());updateTextStats()}
function cleanText(){textInput.value=textInput.value.split('\n').map(x=>x.trim().replace(/\s+/g,' ')).join('\n').trim();updateTextStats()}
async function copyText(){try{await navigator.clipboard.writeText(textInput.value);textStatus.textContent='Copied.'}catch(e){textStatus.textContent='Clipboard access is unavailable in this browser.'}}
function makeQR(){const val=qrText.value.trim();if(!val){qrStatus.textContent='Enter text or a URL first.';return}if(!window.QRCode){qrStatus.textContent='QR library could not load. Check your internet connection.';return}qrResult.innerHTML='';new QRCode(qrResult,{text:val,width:Number(qrSize.value),height:Number(qrSize.value),correctLevel:QRCode.CorrectLevel.H});qrStatus.textContent='QR code generated.'}
function downloadQR(){const canvas=qrResult.querySelector('canvas');const image=qrResult.querySelector('img');if(canvas){canvas.toBlob(b=>downloadBlob(b,'ssg-smart-hub-qr.png'))}else if(image){const a=document.createElement('a');a.href=image.src;a.download='ssg-smart-hub-qr.png';a.click()}else qrStatus.textContent='Generate a QR code first.'}
function syncColor(from){let hex=from==='picker'?colorPicker.value:hexColor.value;if(!/^#[0-9a-fA-F]{6}$/.test(hex))return;colorPicker.value=hex;hexColor.value=hex;colorSwatch.style.background=hex;const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);const max=Math.max(r,g,b)/255,min=Math.min(r,g,b)/255,d=max-min;let h=0,s=0,l=(max+min)/2;if(d){s=d/(1-Math.abs(2*l-1));switch(max){case r/255:h=60*(((g-b)/255/d)%6);break;case g/255:h=60*((b-r)/255/d+2);break;default:h=60*((r-g)/255/d+4)}}colorValues.textContent=`HEX: ${hex.toUpperCase()} · RGB: ${r}, ${g}, ${b} · HSL: ${Math.round((h+360)%360)}°, ${Math.round(s*100)}%, ${Math.round(l*100)}%`}
function copyValue(id){navigator.clipboard?.writeText(document.getElementById(id).value)}
function copyResult(id){navigator.clipboard?.writeText(document.getElementById(id).innerText)}
const capLines={Friendly:['A little inspiration for your day — {x}. ✨','Sharing something special about {x}. What do you think? 💙','Good moments, good energy and a little {x}.'],Professional:['Focused on quality, detail and results. Discover {x}.','A smarter way to approach {x}. Let’s make it happen.','Thoughtfully created, made to make a difference: {x}.'],Funny:['Warning: too much {x} may cause unstoppable smiles. 😂','I tried to be serious about {x}. It didn’t work.','Current mood: 99% {x}, 1% pretending to be productive.'],Inspirational:['Small steps, big dreams — keep moving with {x}. ✨','Your next chapter can start with one bold step. {x}.','Believe in progress, celebrate every little win: {x}.']};
function makeCaption(){const topic=captionTopic.value.trim()||'your next idea';captionResult.textContent=capLines[captionTone.value].map(x=>x.replaceAll('{x}',topic)).join('\n\n')}
function makeHashtags(){const t=(hashTopic.value.trim()||'creator').toLowerCase().replace(/[^a-z0-9 ]/g,'').trim().replace(/\s+/g,'');const base=['#'+t,'#'+t+'daily','#'+t+'community','#'+t+'inspiration','#'+t+'lover','#creative','#trending','#explore','#contentcreator','#ssgsmartHub'];hashResult.textContent=[...new Set(base)].join(' ')}
function webTab(id,btn){document.querySelectorAll('#tool-web .tab').forEach(t=>t.classList.remove('active'));btn.classList.add('active');['unit','date','case'].forEach(x=>document.getElementById('web-'+x).classList.toggle('hidden',x!==id))}
const factors={km:1000,mi:1609.344,m:1,ft:.3048,kg:1,lb:.45359237,l:1,gal:3.785411784};
function convertUnit(){let v=Number(unitValue.value),a=unitFrom.value,b=unitTo.value;if(!Number.isFinite(v)){unitResult.textContent='Enter a valid number.';return}let out;if(a==='c'&&b==='f')out=v*9/5+32;else if(a==='f'&&b==='c')out=(v-32)*5/9;else if(['c','f'].includes(a)||['c','f'].includes(b)){unitResult.textContent='Choose Celsius and Fahrenheit together.';return}else out=v*factors[a]/factors[b];unitResult.textContent=`${v} ${a} = ${Number(out.toFixed(6))} ${b}`}
function dateDifference(){if(!dateStart.value||!dateEnd.value){dateResult.textContent='Choose both dates.';return}const a=new Date(dateStart.value+'T00:00:00Z'),b=new Date(dateEnd.value+'T00:00:00Z');const d=Math.round(Math.abs(b-a)/86400000);dateResult.textContent=`${d} day(s) · ${Math.floor(d/7)} week(s) and ${d%7} day(s).`}
function addDateDays(){if(!addDate.value){addDateResult.textContent='Choose a start date.';return}const d=new Date(addDate.value+'T00:00:00');d.setDate(d.getDate()+Number(addDays.value||0));addDateResult.textContent=d.toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'})}
function reverseText(){utilityResult.textContent=[...utilityText.value].reverse().join('')}
function sortLines(){utilityResult.textContent=utilityText.value.split('\n').sort((a,b)=>a.localeCompare(b)).join('\n')}
function removeDuplicates(){utilityResult.textContent=[...new Set(utilityText.value.split('\n'))].join('\n')}
async function pdfInfo(){const f=pdfInfoFile.files[0];if(!f){pdfInfoResult.textContent='Choose a PDF first.';return}try{if(!window.PDFLib){pdfInfoResult.textContent='PDF library unavailable. Check internet connection.';return}const doc=await PDFLib.PDFDocument.load(await f.arrayBuffer());pdfInfoResult.textContent=`File: ${f.name} · Size: ${(f.size/1024).toFixed(1)} KB · Pages: ${doc.getPageCount()}`}catch(e){pdfInfoResult.textContent='Could not read this PDF. It may be encrypted or damaged.'}}
async function mergePDF(){const files=[...pdfMergeFiles.files];if(files.length<2){pdfMergeStatus.textContent='Select at least two PDF files.';return}try{if(!window.PDFLib)throw Error('PDF library unavailable');const out=await PDFLib.PDFDocument.create();for(const f of files){const doc=await PDFLib.PDFDocument.load(await f.arrayBuffer());const pages=await out.copyPages(doc,doc.getPageIndices());pages.forEach(p=>out.addPage(p))}const bytes=await out.save();downloadBlob(new Blob([bytes],{type:'application/pdf'}),'ssg-merged.pdf');pdfMergeStatus.textContent='Merged successfully.'}catch(e){pdfMergeStatus.textContent='Could not merge PDFs. Check files and library connection.'}}
function parsePages(s,max){const set=new Set();for(const part of s.split(',')){const p=part.trim();if(!p)continue;if(p.includes('-')){let [a,b]=p.split('-').map(Number);if(!Number.isInteger(a)||!Number.isInteger(b)||a<1||b<a||b>max)throw Error('Invalid page range');for(let i=a;i<=b;i++)set.add(i-1)}else{const n=Number(p);if(!Number.isInteger(n)||n<1||n>max)throw Error('Invalid page number');set.add(n-1)}}return [...set].sort((a,b)=>a-b)}
async function extractPDF(){const f=pdfExtractFile.files[0];if(!f){pdfExtractStatus.textContent='Choose a PDF first.';return}try{if(!window.PDFLib)throw Error();const src=await PDFLib.PDFDocument.load(await f.arrayBuffer()),indices=parsePages(pdfPages.value,src.getPageCount());if(!indices.length)throw Error();const out=await PDFLib.PDFDocument.create();const pages=await out.copyPages(src,indices);pages.forEach(p=>out.addPage(p));const bytes=await out.save();downloadBlob(new Blob([bytes],{type:'application/pdf'}),'ssg-extracted-pages.pdf');pdfExtractStatus.textContent='Pages extracted successfully.'}catch(e){pdfExtractStatus.textContent='Check page numbers (example: 1,3,5-7) and ensure the PDF is valid.'}}
function openPDF(){const f=pdfOpenFile.files[0];if(!f){alert('Choose a PDF first.');return}window.open(URL.createObjectURL(f),'_blank','noopener')}
function sendContact(){const recipient=contactTo.value.trim();if(!recipient||!contactTo.checkValidity()){alert('Website owner: enter a valid contact email address first.');return}if(!contactMessage.value.trim()){alert('Please write a message first.');return}const subject=encodeURIComponent(contactSubject.value||'SSG SMART HUB feedback');const body=encodeURIComponent((contactEmail.value?'From: '+contactEmail.value+'\\n\\n':'')+contactMessage.value);location.href=`mailto:${recipient}?subject=${subject}&body=${body}`}
document.getElementById('year').textContent=new Date().getFullYear();syncColor('picker');updateTextStats();
const translations={ur:{home:'ہوم',tools:'تمام ٹولز',about:'تعارف',contact:'رابطہ'},hi:{home:'होम',tools:'सभी टूल',about:'परिचय',contact:'संपर्क'}};
document.getElementById('language').addEventListener('change',e=>{const lang=e.target.value;if(lang==='en'){document.querySelectorAll('[data-page]').forEach(b=>b.textContent=({home:'Home',tools:'All Tools',about:'About',contact:'Contact'})[b.dataset.page]);return}document.querySelectorAll('[data-page]').forEach(b=>b.textContent=translations[lang][b.dataset.page]||b.textContent)});
</script>
